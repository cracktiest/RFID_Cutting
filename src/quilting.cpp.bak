    Serial.println(message);
  }
}

// =====================================================
// LCD
// =====================================================
void lcdPrint16(uint8_t row, String text)
{
  if (text.length() > 16)
  {
    text = text.substring(0, 16);
  }

  lcd.setCursor(0, row);
  lcd.print(text);

  for (int i = text.length(); i < 16; i++)
  {
    lcd.print(' ');
  }
}

void showMessage(
    const String& row1,
    const String& row2 = ""
)
{
  lcdPrint16(0, row1);
  lcdPrint16(1, row2);
}

// =====================================================
// BUZZER
// =====================================================
void buzzerBegin()
{
#if defined(ESP_ARDUINO_VERSION_MAJOR) && ESP_ARDUINO_VERSION_MAJOR >= 3

  ledcAttach(
      BUZZER_PIN,
      BUZZER_FREQUENCY,
      BUZZER_RESOLUTION
  );

  ledcWriteTone(
      BUZZER_PIN,
      0
  );

#else

  ledcSetup(
      BUZZER_CHANNEL,
      BUZZER_FREQUENCY,
      BUZZER_RESOLUTION
  );

  ledcAttachPin(
      BUZZER_PIN,
      BUZZER_CHANNEL
  );

  ledcWriteTone(
      BUZZER_CHANNEL,
      0
  );

#endif
}

void buzzerTone(int frequency)
{
#if defined(ESP_ARDUINO_VERSION_MAJOR) && ESP_ARDUINO_VERSION_MAJOR >= 3

  ledcWriteTone(
      BUZZER_PIN,
      frequency
  );

#else

  ledcWriteTone(
      BUZZER_CHANNEL,
      frequency
  );

#endif
}

void buzzerOff()
{
#if defined(ESP_ARDUINO_VERSION_MAJOR) && ESP_ARDUINO_VERSION_MAJOR >= 3

  ledcWriteTone(
      BUZZER_PIN,
      0
  );

#else

  ledcWriteTone(
      BUZZER_CHANNEL,
      0
  );

#endif
}

void beep(
    int duration = 120,
    int frequency = 2200
)
{
  if (duration <= 0)
  {
    return;
  }

  buzzerTone(frequency);
  delay(duration);
  buzzerOff();
}

void beepCode(int code)
{
  if (code <= 0)
  {
    return;
  }

  if (code == 1)
  {
    beep(120, 2200);
    return;
  }

  if (code == 2)
  {
    beep(100, 2200);
    delay(70);
    beep(100, 2200);
    return;
  }

  beep(450, 900);
}

// =====================================================
// RESET REASON
// =====================================================
String resetReasonText(esp_reset_reason_t reason)
{
  switch (reason)
  {
    case ESP_RST_UNKNOWN:
      return "UNKNOWN";

    case ESP_RST_POWERON:
      return "POWER ON";

    case ESP_RST_EXT:
      return "EXT RESET";

    case ESP_RST_SW:
      return "SOFTWARE RESET";

    case ESP_RST_PANIC:
      return "PANIC CRASH";

    case ESP_RST_INT_WDT:
      return "INT WDT";

    case ESP_RST_TASK_WDT:
      return "TASK WDT";

    case ESP_RST_WDT:
      return "OTHER WDT";

    case ESP_RST_DEEPSLEEP:
      return "DEEP SLEEP";

    case ESP_RST_BROWNOUT:
      return "BROWNOUT";

    case ESP_RST_SDIO:
      return "SDIO RESET";

    default:
      return "RESET " + String((int)reason);
  }
}

String esp_rst()
{
  return resetReasonText(
      esp_reset_reason()
  );
}

// =====================================================
// NORMALISASI MAC
// =====================================================
String normalizeMac(String mac)
{
  mac.trim();

  mac.replace(":", "");
  mac.replace("-", "");
  mac.replace(" ", "");

  mac.toUpperCase();

  return mac;
}

// =====================================================
// VALIDASI HEXADECIMAL
// =====================================================
bool isHexChar(char value)
{
  return (
      (value >= '0' && value <= '9') ||
      (value >= 'A' && value <= 'F')
  );
}

// =====================================================
// VALIDASI MAC
// =====================================================
bool isInvalidMac(String mac)
{
  mac = normalizeMac(mac);

  if (mac.length() != 12)
  {
    return true;
  }

  if (
      mac == "000000000000" ||
      mac == "FFFFFFFFFFFF" ||
      mac == "INVALID_MAC"
  )
  {
    return true;
  }

  for (int i = 0; i < mac.length(); i++)
  {
    if (!isHexChar(mac.charAt(i)))
    {
      return true;
    }
  }

  return false;
}

// =====================================================
// KONVERSI BYTE MAC MENJADI STRING
// =====================================================
String macFromBytes(const uint8_t mac[6])
{
  char buffer[13];

  snprintf(
      buffer,
      sizeof(buffer),
      "%02X%02X%02X%02X%02X%02X",
      mac[0],
      mac[1],
      mac[2],
      mac[3],
      mac[4],
      mac[5]
  );

  return String(buffer);
}

// =====================================================
// AMBIL MAC AMAN
// =====================================================
String getSafeMacAddress()
{
  String mac = "";

  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);

  delay(200);

  for (int attempt = 0; attempt < 20; attempt++)
  {
    uint8_t macBytes[6] = {
        0, 0, 0, 0, 0, 0
    };

    // =================================================
    // CARA 1: esp_wifi_get_mac
    // =================================================
    esp_err_t wifiMacResult =
        esp_wifi_get_mac(
            WIFI_IF_STA,
            macBytes
        );

    if (wifiMacResult == ESP_OK)
    {
      mac = normalizeMac(
          macFromBytes(macBytes)
      );

      if (!isInvalidMac(mac))
      {
        debugPrint(
            "MAC esp_wifi_get_mac: " +
            mac
        );

        return mac;
      }
    }

    // =================================================
    // CARA 2: esp_read_mac
    // =================================================
#if defined(ESP_MAC_WIFI_STA)

    esp_read_mac(
        macBytes,
        ESP_MAC_WIFI_STA
    );

    mac = normalizeMac(
        macFromBytes(macBytes)
    );

    if (!isInvalidMac(mac))
    {
      debugPrint(
          "MAC esp_read_mac: " +
          mac
      );

      return mac;
    }

#endif

    // =================================================
    // CARA 3: WiFi.macAddress
    // =================================================
    mac = normalizeMac(
        WiFi.macAddress()
    );

    if (!isInvalidMac(mac))
    {
      debugPrint(
          "MAC WiFi.macAddress: " +
          mac
      );

      return mac;
    }

    debugPrint(
        "MAC invalid retry " +
        String(attempt + 1) +
        ": " +
        mac
    );

    delay(250);
  }

  return "INVALID_MAC";
}

String macForDisplay()
{
  String mac = normalizeMac(deviceId);

  if (mac.length() == 12)
  {
    return mac;
  }

  return "MAC INVALID";
}

