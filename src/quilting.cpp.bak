// =====================================================
// VALIDASI KONFIGURASI
// =====================================================
bool validDeviceConfig()
{
  String type = String(DEVICE_TYPE);
  String bagian = String(DEVICE_BAGIAN);

  type.trim();
  type.toLowerCase();

  bagian.trim();
  bagian.toLowerCase();

  bool typeValid =
      type == "in" ||
      type == "out";

  bool bagianValid =
      bagian == "quilting" ||
      bagian == "downfilling";

  return typeValid && bagianValid;
}

// =====================================================
// BUILD SCAN TYPE
// =====================================================
String buildScanType()
{
  String type = String(DEVICE_TYPE);
  String bagian = String(DEVICE_BAGIAN);

  type.trim();
  type.toLowerCase();

  bagian.trim();
  bagian.toLowerCase();

  return type + "_" + bagian;
}

// =====================================================
// MODE INPUT
// =====================================================
String inputModeText()
{
  switch (inputMode)
  {
    case MODE_GOOD:
      return "GOOD";

    case MODE_REWORK:
      return "REWORK";

    case MODE_REJECT:
      return "REJECT";

    default:
      return "GOOD";
  }
}

long activeModeTotal()
{
  switch (inputMode)
  {
    case MODE_GOOD:
      return totalGood;

    case MODE_REWORK:
      return totalRework;

    case MODE_REJECT:
      return totalReject;

    default:
      return totalGood;
  }
}

// =====================================================
// POTONG NAMA OPERATOR
// =====================================================
String shortOperatorName(
    String name,
    int maxLength
)
{
  name.trim();
  name.toUpperCase();

  if (name.length() == 0)
  {
    return "NO LOGIN";
  }

  if (name.length() > maxLength)
  {
    return name.substring(0, maxLength);
  }

  return name;
}

// =====================================================
// TAMPILAN IDLE
// =====================================================
void showReady()
{
  if (!operatorLoggedIn)
  {
    showMessage(
        "NO LOGIN",
        "TAP KARTU USER"
    );

    return;
  }

  String lineText = operatorLine;
  lineText.trim();

  if (lineText.length() == 0)
  {
    lineText = "0";
  }

  // ===================================================
  // BARIS 1
  // Contoh: L1 | RANGGA
  // ===================================================
  String row1Prefix =
      "L" +
      lineText +
      " | ";

  int availableNameLength =
      16 - row1Prefix.length();

  if (availableNameLength < 1)
  {
    availableNameLength = 1;
  }

  String row1 =
      row1Prefix +
      shortOperatorName(
          operatorName,
          availableNameLength
      );

  // ===================================================
  // BARIS 2
  // Contoh:
  // IN | GOOD = 5
  // IN | REWORK = 4
  // IN | REJECT = 2
  // ===================================================
  String typeText = String(DEVICE_TYPE);

  typeText.trim();
  typeText.toUpperCase();

  String row2 =
      typeText +
      " | " +
      inputModeText() +
      " = " +
      String(activeModeTotal());

  lcdPrint16(0, row1);
  lcdPrint16(1, row2);
}

// =====================================================
// KEMBALI KE IDLE
// =====================================================
void scheduleReady()
{
  returnToReady = true;
  returnReadyStart = millis();
}

// =====================================================
// TAMPILKAN MAC DAN RESTART
// =====================================================
void displayMacAndRestart()
{
  rfidProcessing = false;
  restoreRequested = false;
  returnToReady = false;

  showMessage(
      "DEVICE MAC:",
      macForDisplay()
  );

  beepCode(1);

  delay(3000);

  showMessage(
      "RESTART ESP32",
      "PLEASE WAIT"
  );

  beepCode(2);

  delay(500);

  Serial.println(
      "Menjalankan ESP.restart()"
  );

  Serial.flush();

  ESP.restart();
}

// =====================================================
// UBAH MODE INPUT
//
// GOOD -> REWORK -> REJECT -> GOOD
// =====================================================
void toggleInputMode()
{
  switch (inputMode)
  {
    case MODE_GOOD:
      inputMode = MODE_REWORK;
      break;

    case MODE_REWORK:
      inputMode = MODE_REJECT;
      break;

    case MODE_REJECT:
    default:
      inputMode = MODE_GOOD;
      break;
  }

  showMessage(
      "MODE INPUT:",
      inputModeText()
  );

  if (inputMode == MODE_GOOD)
  {
    beepCode(1);
  }
  else
  {
    beepCode(2);
  }

  debugPrint(
      "Mode input berubah: " +
      inputModeText()
  );

  delay(700);

  showReady();
}

// =====================================================
// HANDLE TOMBOL
// =====================================================
void handleButton()
{
  bool reading =
      digitalRead(BUTTON_PIN);

  unsigned long now =
      millis();

  if (reading != lastButtonReading)
  {
    lastButtonReading = reading;
    buttonChangedAt = now;
  }

  if (
      now - buttonChangedAt <
      BUTTON_DEBOUNCE_MS
  )
  {
    return;
  }

  if (reading == stableButtonState)
  {
    return;
  }

  stableButtonState = reading;

  if (stableButtonState != LOW)
  {
    return;
  }

  if (
      now - lastButtonActionAt <
      BUTTON_REPEAT_BLOCK_MS
  )
  {
    return;
  }

  lastButtonActionAt = now;

  // ===================================================
  // BELUM LOGIN:
  // tampilkan MAC lalu restart
  // ===================================================
  if (!operatorLoggedIn)
  {
    displayMacAndRestart();
    return;
  }

  // ===================================================
  // SUDAH LOGIN:
  // GOOD -> REWORK -> REJECT -> GOOD
  // ===================================================
  toggleInputMode();
}

// =====================================================
// MAC INVALID
// =====================================================
void haltInvalidMac()
{
  debugPrint(
      "FATAL: INVALID MAC ADDRESS"
  );

  showMessage(
      "MAC INVALID",
      "TEKAN TOMBOL"
  );

  beepCode(3);

  while (true)
  {
    /*
     * Karena belum login, tombol akan menjalankan
     * displayMacAndRestart().
     */
    handleButton();

    delay(2);
  }
}

bool ensureValidDeviceId()
{
  if (!isInvalidMac(deviceId))
  {
    return true;
  }

  haltInvalidMac();

  return false;
}

// =====================================================
// BUILD MQTT TOPIC
// =====================================================
void buildTopics()
{
  ensureValidDeviceId();

  topicResponse =
      "quiltdown/response/" +
      deviceId;

  topicStatus =
      "quiltdown/status/" +
      deviceId;

  topicReset =
      "quiltdown/reset/" +
      deviceId;
}

// =====================================================
// OPTIMASI WIRELESS
// =====================================================
void optimizeWireless()
{
  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);
  WiFi.setAutoReconnect(true);
  WiFi.persistent(false);

  esp_wifi_set_ps(
      WIFI_PS_NONE
  );

  btStop();
}

// =====================================================
// MULAI WIFI
// =====================================================
void startWiFi()
{
  ensureValidDeviceId();

  debugPrint(
      "Menyambungkan ke WiFi: " +
      String(WIFI_SSID)
  );

  showMessage(
      "CONNECT WIFI",
      WIFI_SSID
  );

  WiFi.disconnect(false);

  delay(50);

  WiFi.mode(WIFI_STA);

  WiFi.begin(
      WIFI_SSID,
      WIFI_PASS
  );

  lastWifiAttempt = millis();
}

// =====================================================
// MAINTAIN WIFI
// =====================================================
void maintainWiFi()
{
  ensureValidDeviceId();

  if (WiFi.status() == WL_CONNECTED)
  {
    if (!wifiWasConnected)
    {
      wifiWasConnected = true;
      mqttWasConnected = false;

      lastMqttAttempt = 0;

      debugPrint(
          "WiFi connected"
      );

      debugPrint(
          "SSID : " +
          WiFi.SSID()
      );

      debugPrint(
          "IP   : " +
          WiFi.localIP().toString()
      );

      debugPrint(
          "RSSI : " +
          String(WiFi.RSSI())
      );

      showMessage(
          "WIFI CONNECTED",
          WiFi.localIP().toString()
      );

      beepCode(1);
    }

    return;
  }

  if (wifiWasConnected)
  {
    wifiWasConnected = false;
    mqttWasConnected = false;

    mqttClient.disconnect();

    rfidProcessing = false;
    restoreRequested = false;
    restoreCompleted = false;

    showMessage(
        "WIFI LOST",
        "RECONNECT..."
    );

    beepCode(3);
  }

  if (
      millis() - lastWifiAttempt >=
      WIFI_RETRY_INTERVAL
  )
  {
    startWiFi();
  }
}

// =====================================================
// PUBLISH RESET INFO
// =====================================================
void publishResetInfo()
{
  if (!mqttClient.connected())
  {
    return;
  }

  JsonDocument doc;

  doc["mac"]          = deviceId;
  doc["type"]         = DEVICE_TYPE;
  doc["bagian"]       = DEVICE_BAGIAN;
  doc["scan_type"]    = scanType;
  doc["reset_reason"] = bootResetReason;
  doc["free_heap"]    = ESP.getFreeHeap();
  doc["sketch_size"]  = ESP.getSketchSize();
  doc["flash_size"]   = ESP.getFlashChipSize();
  doc["cpu_mhz"]      = ESP.getCpuFreqMHz();

  char payload[512];

  size_t payloadLength =
      serializeJson(
          doc,
          payload,
          sizeof(payload)
      );

  if (
      payloadLength == 0 ||
      payloadLength >= sizeof(payload)
  )
  {
    debugPrint(
        "Payload reset gagal dibuat"
    );

    return;
  }

  mqttClient.publish(
      topicReset.c_str(),
      reinterpret_cast<const uint8_t*>(payload),
      static_cast<unsigned int>(payloadLength),
      true
  );
}

// =====================================================
// REQUEST ID
// =====================================================
String makeRequestId()
{
  return
      deviceId +
      "-" +
      String(millis()) +
      "-" +
      String(esp_random(), HEX);
}

// =====================================================
// REQUEST RESTORE SESSION
// =====================================================
bool requestRestoreSession()
{
  ensureValidDeviceId();

  if (!mqttClient.connected())
  {
    return false;
  }

  if (restoreRequested)
  {
    return false;
  }

  lastRequestId =
      makeRequestId();

  JsonDocument doc;

  doc["request_id"] =
      lastRequestId;

  doc["action"] =
      "restore_session";

  doc["mac"] =
      deviceId;

  doc["type"] =
      DEVICE_TYPE;

  doc["bagian"] =
      DEVICE_BAGIAN;

  doc["scan_type"] =
      scanType;

  doc["reset_reason"] =
      bootResetReason;

  doc["uptime_ms"] =
      millis();

  doc["rssi"] =
      WiFi.RSSI();

  char payload[512];

  size_t payloadLength =
      serializeJson(
          doc,
          payload,
          sizeof(payload)
      );

  if (
      payloadLength == 0 ||
      payloadLength >= sizeof(payload)
  )
  {
    showMessage(
        "RESTORE ERROR",
        "JSON GAGAL"
    );

    return false;
  }

  bool published =
      mqttClient.publish(
          TOPIC_REQUEST,
          reinterpret_cast<const uint8_t*>(payload),
          static_cast<unsigned int>(payloadLength),
          false
      );

  if (!published)
  {
    showMessage(
        "RESTORE GAGAL",
        "COBA KEMBALI"
    );

    return false;
  }

  restoreRequested = true;
  restoreCompleted = false;
  restoreRequestAt = millis();

  showMessage(
      "CEK LOGIN",
      "MOHON TUNGGU"
  );

  debugPrint(
      "Restore session request:"
  );

  debugPrint(
      String(payload)
  );

  return true;
}

// =====================================================
// MAINTAIN MQTT
// =====================================================
void maintainMQTT()
{
  ensureValidDeviceId();

  if (WiFi.status() != WL_CONNECTED)
  {
    return;
  }

  if (mqttClient.connected())
  {
    return;
  }

  if (
      millis() - lastMqttAttempt <
      MQTT_RETRY_INTERVAL
  )
  {
    return;
  }

  lastMqttAttempt = millis();

  String clientId =
      "QUILTDOWN-" +
      scanType +
      "-" +
      deviceId;

  bool connected =
      mqttClient.connect(
          clientId.c_str(),
          topicStatus.c_str(),
          0,
          true,
          "offline"
      );

  if (!connected)
  {
    debugPrint(
        "MQTT gagal, state=" +
        String(mqttClient.state())
    );

    showMessage(
        "MQTT FAILED",
        "RETRY..."
    );

    return;
  }

  mqttWasConnected = true;

  bool subscribed =
      mqttClient.subscribe(
          topicResponse.c_str(),
          1
      );

  mqttClient.publish(
      topicStatus.c_str(),
      "online",
      true
  );

  publishResetInfo();

  debugPrint(
      "MQTT connected"
  );

  debugPrint(
      "Subscribe: " +
      topicResponse
  );

  debugPrint(
      String("Subscribe status: ") +
      (subscribed ? "SUCCESS" : "FAILED")
  );

  showMessage(
      "MQTT SUCCESS",
      scanType
  );

  beepCode(1);

  delay(500);

  restoreRequested = false;
  restoreCompleted = false;

  requestRestoreSession();
}

// =====================================================
// PUBLISH SCAN RFID
// =====================================================
bool publishSmartRequest(const String& tag)
{
  ensureValidDeviceId();

  if (restoreRequested)
  {
    showMessage(
        "CEK LOGIN",
        "MOHON TUNGGU"
    );

    return false;
  }

  if (WiFi.status() != WL_CONNECTED)
  {
    showMessage(
        "WIFI LOST",
        "TUNGGU KONEKSI"
    );

    beepCode(3);
    scheduleReady();

    return false;
  }

  if (!mqttClient.connected())
  {
    showMessage(
        "SERVER LOST",
        "TUNGGU KONEKSI"
    );

    beepCode(3);
    scheduleReady();

    return false;
  }

  lastRequestId =
      makeRequestId();

  JsonDocument doc;

  doc["request_id"] =
      lastRequestId;

  doc["action"] =
      "scan";

  doc["mac"] =
      deviceId;

  doc["rfid"] =
      tag;

  doc["type"] =
      DEVICE_TYPE;

  doc["bagian"] =
      DEVICE_BAGIAN;

  doc["scan_type"] =
      scanType;

  doc["input_status"] =
      inputModeText();

  doc["logged_in"] =
      operatorLoggedIn;

  doc["operator_rfid"] =
      activeOperatorRfid;

  doc["operator_name"] =
      operatorName;

  doc["line"] =
      operatorLine;

  doc["reset_reason"] =
      bootResetReason;

  doc["uptime_ms"] =
      millis();

  doc["rssi"] =
      WiFi.RSSI();

  char payload[768];

  size_t payloadLength =
      serializeJson(
          doc,
          payload,
          sizeof(payload)
      );

  if (
      payloadLength == 0 ||
      payloadLength >= sizeof(payload)
  )
  {
    showMessage(
        "JSON ERROR",
        "PAYLOAD GAGAL"
    );

    beepCode(3);
    scheduleReady();

    return false;
  }

  bool published =
      mqttClient.publish(
          TOPIC_REQUEST,
          reinterpret_cast<const uint8_t*>(payload),
          static_cast<unsigned int>(payloadLength),
          false
      );

  if (!published)
  {
    showMessage(
        "KIRIM GAGAL",
        "SCAN ULANG"
    );

    beepCode(3);
    scheduleReady();

    return false;
  }

  rfidProcessing = true;
  rfidProcessingStart = millis();

  if (!operatorLoggedIn)
  {
    showMessage(
        "CEK USER",
        tag
    );
  }
  else
  {
    showMessage(
        "SCAN " +
        inputModeText(),
        tag
    );
  }

  beepCode(1);

  debugPrint(
      "================================="
  );

  debugPrint(
      "MQTT SCAN REQUEST"
  );

  debugPrint(
      "Request ID   : " +
      lastRequestId
  );

  debugPrint(
      "RFID         : " +
      tag
  );

  debugPrint(
      "Input Status : " +
      inputModeText()
  );

  debugPrint(
      "Payload      : " +
      String(payload)
  );

  debugPrint(
      "================================="
  );

  return true;
}

// =====================================================
// RESET SESSION LOKAL
// =====================================================
void clearLocalSession()
{
  operatorLoggedIn = false;

  activeOperatorRfid = "";
  operatorName       = "NO LOGIN";
  operatorLine       = "";

  totalGood   = 0;
  totalRework = 0;
  totalReject = 0;

  inputMode = MODE_GOOD;
}

// =====================================================
// UPDATE SESSION DAN COUNTER
// =====================================================
void updateSessionAndCounter(JsonDocument& doc)
{
  String code =
      doc["code"] | "";

  code.trim();
  code.toUpperCase();

  // ===================================================
  // RESTORE EMPTY
  // ===================================================
  if (code == "RESTORE_EMPTY")
  {
    clearLocalSession();

    restoreRequested = false;
    restoreCompleted = true;

    return;
  }

  // ===================================================
  // LOGOUT
  // ===================================================
  if (code == "LOGOUT")
  {
    clearLocalSession();

    return;
  }

  // ===================================================
  // LOGIN / CHANGE USER / RESTORE
  // ===================================================
  if (
      code == "LOGIN" ||
      code == "CHANGE_USER" ||
      code == "RESTORE"
  )
  {
    operatorLoggedIn = true;

    activeOperatorRfid =
        String(
            doc["user"]["rfid"] | ""
        );

    operatorName =
        String(
            doc["user"]["name"] | ""
        );

    operatorLine =
        String(
            doc["user"]["line"] | ""
        );

    totalGood =
        doc["totals"]["good"] | 0;

    totalRework =
        doc["totals"]["rework"] | 0;

    totalReject =
        doc["totals"]["reject"] | 0;

    /*
     * Setelah login, change user, atau restart,
     * alat kembali ke mode GOOD.
     */
    inputMode = MODE_GOOD;

    if (code == "RESTORE")
    {
      restoreRequested = false;
      restoreCompleted = true;
    }

    return;
  }

  // ===================================================
  // GOOD SAVED
  // ===================================================
  if (code == "GOOD_SAVED")
  {
    totalGood =
        doc["totals"]["good"] |
        (totalGood + 1);

    totalRework =
        doc["totals"]["rework"] |
        totalRework;

    totalReject =
        doc["totals"]["reject"] |
        totalReject;

    return;
  }

  // ===================================================
  // REWORK SAVED
  // ===================================================
  if (code == "REWORK_SAVED")
  {
    totalGood =
        doc["totals"]["good"] |
        totalGood;

    totalRework =
        doc["totals"]["rework"] |
        (totalRework + 1);

    totalReject =
        doc["totals"]["reject"] |
        totalReject;

    return;
  }

  // ===================================================
  // REJECT SAVED
  // ===================================================
  if (code == "REJECT_SAVED")
  {
    totalGood =
        doc["totals"]["good"] |
        totalGood;

    totalRework =
        doc["totals"]["rework"] |
        totalRework;

    totalReject =
        doc["totals"]["reject"] |
        (totalReject + 1);

    return;
  }
}

// =====================================================
// HANDLE RESPONSE BACKEND
// =====================================================
void handleBackendResponse(
    const uint8_t* payload,
    unsigned int length
)
{
  JsonDocument doc;

  DeserializationError jsonError =
      deserializeJson(
          doc,
          payload,
          length
      );

  if (jsonError)
  {
    debugPrint(
        "JSON response error: " +
        String(jsonError.c_str())
    );

    rfidProcessing = false;
    restoreRequested = false;

    showMessage(
        "RESPON RUSAK",
        "JSON INVALID"
    );

    beepCode(3);
    scheduleReady();

    return;
  }

  String responseRequestId =
      doc["request_id"] | "";

  if (
      responseRequestId.length() > 0 &&
      responseRequestId != lastRequestId
  )
  {
    debugPrint(
        "Response diabaikan, request_id berbeda"
    );

    return;
  }

  rfidProcessing = false;

  bool ok =
      doc["ok"] | false;

  String code =
      doc["code"] | "UNKNOWN";

  String message =
      doc["message"] | "";

  String name =
      doc["user"]["name"] | "";

  code.trim();
  code.toUpperCase();

  debugPrint(
      "================================="
  );

  debugPrint(
      "RESPONSE BACKEND"
  );

  debugPrint(
      String("OK      : ") +
      (ok ? "true" : "false")
  );

  debugPrint(
      "Code    : " +
      code
  );

  debugPrint(
      "Message : " +
      message
  );

  debugPrint(
      "================================="
  );

  // ===================================================
  // RESPONSE GAGAL
  // ===================================================
  if (!ok)
  {
    restoreRequested = false;

    if (code == "LOGIN_REQUIRED")
    {
      showMessage(
          "BELUM LOGIN",
          "TAP USER DULU"
      );
    }
    else if (code == "INVALID_MAC")
    {
      showMessage(
          "MAC INVALID",
          "TEKAN TOMBOL"
      );
    }
    else if (code == "SESSION_TYPE_MISMATCH")
    {
      showMessage(
          "SESSION BEDA",
          "LOGIN ULANG"
      );
    }
    else if (code == "SESSION_USER_INVALID")
    {
      showMessage(
          "SESSION ERROR",
          "USER TDK ADA"
      );
    }
    else if (code == "USER_NOT_FOUND")
    {
      showMessage(
          "KARTU DITOLAK",
          "USER TDK ADA"
      );
    }
    else if (code == "DUPLICATE_SCAN")
    {
      showMessage(
          "SUDAH DIINPUT",
          "SCAN DITOLAK"
      );
    }
    else if (code == "INVALID_INPUT_STATUS")
    {
      showMessage(
          "MODE INVALID",
          inputModeText()
      );
    }
    else if (
        code == "SERVER_ERROR" ||
        code == "RESTORE_SERVER_ERROR"
    )
    {
      showMessage(
          "DATABASE ERROR",
          "CEK SERVER"
      );
    }
    else
    {
      showMessage(
          "PROSES GAGAL",
          message
      );
    }

    beepCode(3);

    if (code != "INVALID_MAC")
    {
      scheduleReady();
    }

    return;
  }

  updateSessionAndCounter(doc);

  // ===================================================
  // RESTORE
  // ===================================================
  if (code == "RESTORE")
  {
    showMessage(
        "LOGIN DILANJUT",
        name
    );

    beepCode(1);

    delay(1000);

    showReady();

    return;
  }

  // ===================================================
  // RESTORE EMPTY
  // ===================================================
  if (code == "RESTORE_EMPTY")
  {
    showMessage(
        "BELUM LOGIN",
        "TAP KARTU USER"
    );

    beepCode(1);

    delay(700);

    showReady();

    return;
  }

  // ===================================================
  // LOGIN
  // ===================================================
  if (code == "LOGIN")
  {
    showMessage(
        "LOGIN BERHASIL",
        name
    );

    beepCode(1);
    scheduleReady();

    return;
  }

  // ===================================================
  // LOGOUT
  // ===================================================
  if (code == "LOGOUT")
  {
    showMessage(
        "LOGOUT BERHASIL",
        name
    );

    beepCode(2);
    scheduleReady();

    return;
  }

  // ===================================================
  // CHANGE USER
  // ===================================================
  if (code == "CHANGE_USER")
  {
    showMessage(
        "GANTI OPERATOR",
        name
    );

    beepCode(2);
    scheduleReady();

    return;
  }

  // ===================================================
  // GOOD SAVED
  // ===================================================
  if (code == "GOOD_SAVED")
  {
    showMessage(
        "GOOD TERSIMPAN",
        "TOTAL=" +
        String(totalGood)
    );

    beepCode(1);
    scheduleReady();

    return;
  }

  // ===================================================
  // REWORK SAVED
  // ===================================================
  if (code == "REWORK_SAVED")
  {
    showMessage(
        "REWORK SIMPAN",
        "TOTAL=" +
        String(totalRework)
    );

    beepCode(2);
    scheduleReady();

    return;
  }

  // ===================================================
  // REJECT SAVED
  // ===================================================
  if (code == "REJECT_SAVED")
  {
    showMessage(
        "REJECT SIMPAN",
        "TOTAL=" +
        String(totalReject)
    );

    beepCode(2);
    scheduleReady();

    return;
  }

  showMessage(
      "BERHASIL",
      message
  );

  beepCode(1);
  scheduleReady();
}

// =====================================================
// MQTT CALLBACK
// =====================================================
void mqttCallback(
    char* topic,
    byte* payload,
    unsigned int length
)
{
  String incomingTopic =
      String(topic);

  if (incomingTopic != topicResponse)
  {
    return;
  }

  handleBackendResponse(
      payload,
      length
  );
}

// =====================================================
// RFID RDM6300
// =====================================================
String readTag(Stream& serial)
{
  if (!serial.available())
  {
    return "";
  }

  int firstByte =
      serial.read();

  if (firstByte != 0x02)
  {
    return "";
  }

  String hexData = "";

  unsigned long start =
      millis();

  while (
      millis() - start <
      100
  )
  {
    if (!serial.available())
    {
      delay(1);
      continue;
    }

    char value =
        static_cast<char>(
            serial.read()
        );

    if (value == 0x03)
    {
      break;
    }

    hexData += value;
  }

  if (hexData.length() < 12)
  {
    debugPrint(
        "RFID frame terlalu pendek: " +
        hexData
    );

    return "";
  }

  String tagHex =
      hexData.substring(0, 10);

  String serialHex =
      tagHex.substring(2, 10);

  uint64_t tagDecimal =
      strtoull(
          serialHex.c_str(),
          nullptr,
          16
      );

  char buffer[20];

  snprintf(
      buffer,
      sizeof(buffer),
      "%010llu",
      static_cast<unsigned long long>(
          tagDecimal
      )
  );

  return String(buffer);
}

// =====================================================
// RFID DEBOUNCE
// =====================================================
bool allowRFID(const String& tag)
{
  unsigned long now =
      millis();

  if (
      tag == lastTag &&
      now - lastReadTime <
      RFID_DEBOUNCE_TIME
  )
  {
    lastReadTime = now;

    debugPrint(
        "RFID duplicate diabaikan: " +
        tag
    );

    return false;
  }

  if (
      rfidProcessing ||
      restoreRequested
  )
  {
    lastTag = tag;
    lastReadTime = now;

    debugPrint(
        "RFID diabaikan, proses sebelumnya belum selesai"
    );

    return false;
  }

  lastTag = tag;
  lastReadTime = now;

  return true;
}

// =====================================================
// PROCESS RFID
// =====================================================
void processTag(String tag)
{
  ensureValidDeviceId();

  tag.trim();

  if (
      tag.length() == 0 ||
      tag.length() > 30
  )
  {
    return;
  }

  if (!allowRFID(tag))
  {
    return;
  }

  debugPrint(
      "RFID terbaca: " +
      tag
  );

  publishSmartRequest(tag);
}

// =====================================================
// SETUP
// =====================================================
void setup()
{
  Serial.begin(115200);

  delay(300);

  // ===================================================
  // PIN
  // ===================================================
  pinMode(
      BUTTON_PIN,
      INPUT_PULLUP
  );

  pinMode(
      BUZZER_PIN,
      OUTPUT
  );

  digitalWrite(
      BUZZER_PIN,
      LOW
  );

  buzzerBegin();

  // ===================================================
  // LCD
  // ===================================================
  lcd.init();
  lcd.backlight();

// const char* DEVICE_TYPE   = "out";
// const char* DEVICE_BAGIAN = "quilting";
  showMessage(
      DEVICE_TYPE ,
      DEVICE_BAGIAN
  );

  beepCode(1);

  // ===================================================
  // RFID UART
  // ===================================================
  RFID.begin(
      RFID_BAUD,
      SERIAL_8N1,
      RFID_RX_PIN,
      RFID_TX_PIN
  );

  // ===================================================
  // VALIDASI CONFIG
  // ===================================================
  if (!validDeviceConfig())
  {
    showMessage(
        "CONFIG ERROR",
        "TYPE/BAGIAN"
    );

    beepCode(3);

    while (true)
    {
      delay(1000);
    }
  }

  scanType =
      buildScanType();

  // ===================================================
  // OPTIMASI WIFI
  // ===================================================
  optimizeWireless();

  // ===================================================
  // AMBIL MAC
  // ===================================================
  deviceId =
      getSafeMacAddress();

  if (isInvalidMac(deviceId))
  {
    haltInvalidMac();
  }

  // ===================================================
  // MAC TAMPIL 1 DETIK SAAT BOOT
  // ===================================================
  showMessage(
      "DEVICE MAC:",
      deviceId
  );

  delay(1000);

  // ===================================================
  // RESET REASON
  // ===================================================
  bootResetReason =
      esp_rst();

  printResetDebug();
  showResetReasonOnLCD();

  // ===================================================
  // TOPIK MQTT
  // ===================================================
  buildTopics();

  debugPrint(
      "Device ID      : " +
      deviceId
  );

  debugPrint(
      "Scan Type      : " +
      scanType
  );

  debugPrint(
      "Topic Request  : " +
      String(TOPIC_REQUEST)
  );

  debugPrint(
      "Topic Response : " +
      topicResponse
  );

  // ===================================================
  // MQTT
  // ===================================================
  mqttClient.setServer(
      MQTT_SERVER,
      MQTT_PORT
  );

  mqttClient.setCallback(
      mqttCallback
  );

  mqttClient.setBufferSize(1536);
  mqttClient.setKeepAlive(30);
  mqttClient.setSocketTimeout(5);

  lastWifiAttempt =
      millis() -
      WIFI_RETRY_INTERVAL;

  lastMqttAttempt =
      millis() -
      MQTT_RETRY_INTERVAL;

  maintainWiFi();
}

// =====================================================
// LOOP
// =====================================================
void loop()
{
  ensureValidDeviceId();

  // ===================================================
  // TOMBOL
  // ===================================================
  handleButton();

  // ===================================================
  // CONNECTION
  // ===================================================
  maintainWiFi();
  maintainMQTT();

  if (mqttClient.connected())
  {
    mqttClient.loop();
  }

  // ===================================================
  // RESTORE TIMEOUT
  // ===================================================
  if (
      restoreRequested &&
      !restoreCompleted &&
      millis() - restoreRequestAt >=
      RESTORE_TIMEOUT
  )
  {
    restoreRequested = false;
    restoreCompleted = false;

    clearLocalSession();

    showMessage(
        "RESTORE TIMEOUT",
        "TAP USER ULANG"
    );

    beepCode(3);
    scheduleReady();
  }

  // ===================================================
  // RFID PROCESSING TIMEOUT
  // ===================================================
  if (
      rfidProcessing &&
      millis() - rfidProcessingStart >=
      RFID_PROCESSING_TIMEOUT
  )
  {
    rfidProcessing = false;

    showMessage(
        "SERVER TIMEOUT",
        "SCAN ULANG"
    );

    beepCode(3);
    scheduleReady();
  }

  // ===================================================
  // KEMBALI KE IDLE
  // ===================================================
  if (
      returnToReady &&
      millis() - returnReadyStart >=
      READY_RETURN_DELAY
  )
  {
    returnToReady = false;

    showReady();
  }

  // ===================================================
  // HEARTBEAT
  // ===================================================
  if (
      mqttClient.connected() &&
      millis() - lastHeartbeat >=
      HEARTBEAT_INTERVAL
  )
  {
    lastHeartbeat = millis();

    mqttClient.publish(
        topicStatus.c_str(),
        "online",
        true
    );
  }

  // ===================================================
  // BACA RFID
  // ===================================================
  String tag =
      readTag(RFID);

  if (tag.length() > 0)
  {
    processTag(tag);
  }

  delay(2);
}