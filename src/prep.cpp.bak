  // Screen 1: BOOT / WIFI / MQTT / Bundle
  lcdPrint16(0, deviceId);
  lcdPrint16(1, "B" + String(bootCount) + " W" + String(wifiReconnectCount) + " M" + String(mqttReconnectCount) + " C" + String(countBundle));
  delay(2200);

  // Screen 2: scan type dan reset reason terakhir
  lcdPrint16(0, "TYPE " + scanTypeUpper());
  lcdPrint16(1, resetReasonText());
  delay(2200);
}

// =====================================================
// SIMPLE JSON PARSER
// =====================================================
String jsonGetString(const String &json, const String &key) {
  const String pattern = "\"" + key + "\"";
  int position = json.indexOf(pattern);

  if (position < 0) {
    return "";
  }

  position = json.indexOf(':', position + pattern.length());

  if (position < 0) {
    return "";
  }

  position++;
  const int jsonLength = json.length();

  while (position < jsonLength && (json[position] == ' ' || json[position] == '\t')) {
    position++;
  }

  if (position >= jsonLength) {
    return "";
  }

  if (json[position] == '"') {
    position++;
    String value;
    bool escape = false;

    while (position < jsonLength) {
      const char current = json[position++];

      if (escape) {
        value += current;
        escape = false;
      } else if (current == '\\') {
        escape = true;
      } else if (current == '"') {
        break;
      } else {
        value += current;
      }
    }

    return value;
  }

  int end = position;

  while (end < jsonLength && json[end] != ',' && json[end] != '}') {
    end++;
  }

  String value = json.substring(position, end);
  value.trim();
  value.replace("\"", "");
  return value;
}

int jsonGetInt(const String &json, const String &key, int defaultValue = 0) {
  String value = jsonGetString(json, key);
  value.trim();

  if (value.length() == 0) {
    return defaultValue;
  }

  return value.toInt();
}

void updateReadyDataFromJson(const String &json) {
  const String action = jsonGetString(json, "action");
  const String jsonOperatorName = jsonGetString(json, "operator_name");
  const String jsonName = jsonGetString(json, "nama");

  if (jsonOperatorName.length() > 0) {
    operatorName = jsonOperatorName;
  } else if (jsonName.length() > 0) {
    operatorName = jsonName;
  }

  const int jsonCountBundle = jsonGetInt(json, "count_bundle", -1);
  const int jsonBundleCount = jsonGetInt(json, "bundle_count", -1);
  const int jsonTotalBundle = jsonGetInt(json, "total_bundle", -1);

  if (jsonCountBundle >= 0) {
    countBundle = jsonCountBundle;
  } else if (jsonBundleCount >= 0) {
    countBundle = jsonBundleCount;
  } else if (jsonTotalBundle >= 0) {
    countBundle = jsonTotalBundle;
  }

  const int jsonLineNo = jsonGetInt(json, "line_no", -1);
  const int jsonLine = jsonGetInt(json, "line", -1);

  if (jsonLineNo >= 0) {
    lineNo = jsonLineNo;
  } else if (jsonLine >= 0) {
    lineNo = jsonLine;
  }

  const int totalOutputQty = jsonGetInt(json, "total_output_qty", -1);
  const int operatorOutput = jsonGetInt(json, "operator_output", -1);
  const int actualOutputJson = jsonGetInt(json, "actual_output", -1);
  const int totalOutput = jsonGetInt(json, "total_output", -1);

  if (totalOutputQty >= 0) {
    actualOutput = totalOutputQty;
  } else if (operatorOutput >= 0) {
    actualOutput = operatorOutput;
  } else if (actualOutputJson >= 0) {
    actualOutput = actualOutputJson;
  } else if (totalOutput >= 0) {
    actualOutput = totalOutput;
  }

  if (action == "logout" || action == "restore_empty") {
    operatorName = "NO LOGIN";
    actualOutput = 0;
    countBundle = 0;
    lineNo = 0;
  }
}

// =====================================================
// RFID PROCESSING
// =====================================================
void releaseRFIDProcessing() {
  rfidProcessing = false;
}

bool allowRFID(const String &tag) {
  const unsigned long now = millis();

  if (rfidProcessing) {
    debugPrint("RFID ignored, waiting response: " + tag);
    return false;
  }

  if (tag == lastTag && now - lastReadTime < RFID_DEBOUNCE_TIME) {
    debugPrint("RFID duplicate ignored: " + tag);
    return false;
  }

  lastTag = tag;
  lastReadTime = now;
  return true;
}

bool publishPayload(const String &payload) {
  if (!ensureValidDeviceId()) {
    return false;
  }

  if (topicTag.length() == 0 || topicStatus.length() == 0 || topicReply.length() == 0) {
    showMessage("TOPIC ERROR", "CEK MAC", 3);
    scheduleReady(2000);
    return false;
  }

  if (WiFi.status() != WL_CONNECTED) {
    showMessage("WIFI LOST", "TUNGGU KONEKSI", 3);
    scheduleReady(2000);
    return false;
  }

  if (!client.connected()) {
    showMessage("SERVER LOST", "TUNGGU KONEKSI", 3);
    scheduleReady(2000);
    return false;
  }

  if (!client.publish(topicTag.c_str(), payload.c_str(), false)) {
    showMessage("KIRIM GAGAL", "SCAN ULANG", 3);
    scheduleReady(2000);
    return false;
  }

  rfidProcessing = true;
  rfidProcessingStart = millis();
  return true;
}

void requestRestoreSession() {
  if (!ensureValidDeviceId()) {
    return;
  }

  if (!validScanType() || restoreRequested || !client.connected()) {
    return;
  }

  const String payload = "__RESTORE__/" + deviceId + "/" + scanType;

  if (publishPayload(payload)) {
    restoreRequested = true;
    debugPrint("Restore session request: " + payload);
    showMessage("SYNC SESSION", "PLEASE WAIT", 0);
  }
}

// =====================================================
// MQTT CALLBACK
// =====================================================
void callback(char *topic, byte *payload, unsigned int length) {
  String message;
  message.reserve(length + 1);

  for (unsigned int i = 0; i < length; i++) {
    message += static_cast<char>(payload[i]);
  }

  message.trim();
  const String topicString = String(topic);
  debugPrint("RX : " + topicString + " = " + message);

  if (topicString != topicReply) {
    return;
  }

  if (!rfidProcessing) {
    debugPrint("Reply ignored, no active request");
    return;
  }

  releaseRFIDProcessing();
  restoreRequested = false;
  updateReadyDataFromJson(message);

  String lcd1 = jsonGetString(message, "lcd1");
  String lcd2 = jsonGetString(message, "lcd2");
  int beepValue = jsonGetInt(message, "beep", 1);

  if (lcd1.length() == 0) {
    lcd1 = "RESP ERROR";
    lcd2 = "CHECK API";
    beepValue = 3;
  }

  showMessage(lcd1, lcd2, beepValue);
  scheduleReady(2500);
}

// =====================================================
// WIFI NON-BLOCKING
// =====================================================
void startWiFi() {
  if (!ensureValidDeviceId()) {
    return;
  }

  debugPrint("Connecting WiFi...");
  showMessage("CONNECT WIFI", ssid, 0);

  WiFi.disconnect(false);
  delay(50);
  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);

  lastWifiAttempt = millis();
}

void maintainWiFi() {
  if (WiFi.status() == WL_CONNECTED) {
    if (!wifiPreviouslyConnected) {
      wifiPreviouslyConnected = true;
      mqttPreviouslyConnected = false;
      restoreRequested = false;
      lastMqttAttempt = 0;

      debugPrint("WiFi connected: " + WiFi.localIP().toString());

      if (firstWifiConnect) {
        firstWifiConnect = false;
        showMessage("WIFI FIRST OK", WiFi.localIP().toString(), 1);
      } else {
        wifiReconnectCount++;
        showWifiReconnectDiagnostic();
        showMessage("WIFI CONNECTED", WiFi.localIP().toString(), 1);
      }

      scheduleReady(1200);
    }

    return;
  }

  if (wifiPreviouslyConnected) {
    wifiPreviouslyConnected = false;
    mqttPreviouslyConnected = false;
    client.disconnect();
    releaseRFIDProcessing();
    restoreRequested = false;

    debugPrint("WiFi lost");
    showMessage("WIFI LOST", "RECONNECT...", 3);
  }

  if (millis() - lastWifiAttempt >= WIFI_RETRY_INTERVAL) {
    startWiFi();
  }
}

// =====================================================
// MQTT NON-BLOCKING
// =====================================================
void maintainMQTT() {
  if (!ensureValidDeviceId()) {
    return;
  }

  if (WiFi.status() != WL_CONNECTED) {
    return;
  }

  if (client.connected()) {
    if (!mqttPreviouslyConnected) {
      mqttPreviouslyConnected = true;
      debugPrint("MQTT connection active");
    }

    return;
  }

  if (mqttPreviouslyConnected) {
    mqttPreviouslyConnected = false;
    releaseRFIDProcessing();
    restoreRequested = false;

    debugPrint("MQTT disconnected");
    showMessage("SERVER LOST", "RECONNECT...", 3);
  }

  if (millis() - lastMqttAttempt < MQTT_RETRY_INTERVAL) {
    return;
  }

  lastMqttAttempt = millis();
  debugPrint("Connecting MQTT...");

  const String clientId = "ESP32-" + scanTypeUpper() + "-" + deviceId;

  const bool connected = client.connect(
    clientId.c_str(),
    topicStatus.c_str(),
    0,
    true,
    "offline"
  );

  if (!connected) {
    debugPrint("MQTT failed, state=" + String(client.state()));
    showMessage("MQTT FAILED", "STATE " + String(client.state()), 0);
    return;
  }

  mqttPreviouslyConnected = true;
  client.subscribe(topicReply.c_str(), 0);
  client.publish(topicStatus.c_str(), "online", true);

  debugPrint("MQTT connected");
  debugPrint("Subscribed: " + topicReply);

  if (firstMqttConnect) {
    firstMqttConnect = false;
    showMessage("MQTT FIRST OK", scanTypeUpper(), 1);
  } else {
    mqttReconnectCount++;
    showMqttReconnectDiagnostic();
    showMessage("MQTT SUCCESS", scanTypeUpper(), 1);
  }

  restoreRequested = false;
  requestRestoreSession();
}

// =====================================================
// OTA UPDATE LOCAL
// =====================================================
void otaStarted() {
  lcdPrint16(0, "OTA START");
  lcdPrint16(1, "DOWNLOADING...");
}

void otaFinished() {
  lcdPrint16(0, "OTA FINISHED");
  lcdPrint16(1, "REBOOTING...");
}

void otaProgress(int current, int total) {
  if (total <= 0) {
    return;
  }

  int percent = (current * 100) / total;
  static int lastPercent = -1;

  if (percent == lastPercent) {
    return;
  }

  lastPercent = percent;

  String row2 = String(percent) + "% " + String(current / 1024) + "/" + String(total / 1024) + "KB";
  lcdPrint16(0, "OTA UPDATE");
  lcdPrint16(1, row2);
}

void otaError(int error) {
  lcdPrint16(0, "OTA ERROR");
  lcdPrint16(1, "CODE " + String(error));
}

void performLocalOTA() {
  if (otaRunning) {
    return;
  }

  otaRunning = true;
  releaseRFIDProcessing();
  restoreRequested = false;
  returnToReady = false;
  buttonMessageActive = false;

  if (WiFi.status() != WL_CONNECTED) {
    showMessage("OTA FAILED", "WIFI LOST", 3);
    otaRunning = false;
    scheduleReady(2500);
    return;
  }

  if (client.connected()) {
    client.publish(topicStatus.c_str(), "ota_update", true);
    client.disconnect();
  }

  String otaUrl = otaFirmwareUrl();

  showMessage("OTA " + scanTypeUpper(), otaFirmwareFileName(), 1);
  delay(1200);

  WiFiClient otaClient;

  httpUpdate.onStart(otaStarted);
  httpUpdate.onEnd(otaFinished);
  httpUpdate.onProgress(otaProgress);
  httpUpdate.onError(otaError);
  httpUpdate.rebootOnUpdate(true);

  t_httpUpdate_return result = httpUpdate.update(
    otaClient,
    otaUrl
  );

  switch (result) {
    case HTTP_UPDATE_FAILED:
      showMessage("OTA FAILED", "ERR " + String(httpUpdate.getLastError()), 3);
      delay(2500);
      showMessage("OTA ERROR MSG", httpUpdate.getLastErrorString(), 0);
      delay(2500);
      break;

    case HTTP_UPDATE_NO_UPDATES:
      showMessage("OTA INFO", "NO UPDATE", 2);
      delay(2500);
      break;

    case HTTP_UPDATE_OK:
      showMessage("OTA OK", "REBOOT...", 1);
      delay(1000);
      break;
  }

  otaRunning = false;
  mqttPreviouslyConnected = false;
  restoreRequested = false;
  lastMqttAttempt = millis() - MQTT_RETRY_INTERVAL;
  scheduleReady(2000);
}

// =====================================================
// RFID READER STX/ETX
// =====================================================
String readTag(Stream &serial) {
  if (!serial.available()) {
    return "";
  }

  if (serial.read() != 0x02) {
    return "";
  }

  String hexData;
  const unsigned long start = millis();

  while (millis() - start < 100) {
    if (!serial.available()) {
      delay(1);
      continue;
    }

    const char current = static_cast<char>(serial.read());

    if (current == 0x03) {
      break;
    }

    hexData += current;
  }

  if (hexData.length() < 12) {
    return "";
  }

  const String tagHex = hexData.substring(0, 10);
  const String serialHex = tagHex.substring(2, 10);
  const uint64_t tagDecimal = strtoull(serialHex.c_str(), nullptr, 16);

  char buffer[20];
  snprintf(buffer, sizeof(buffer), "%010llu", static_cast<unsigned long long>(tagDecimal));

  return String(buffer);
}

void processTag(const String &tag) {
  if (!ensureValidDeviceId()) {
    return;
  }

  if (!allowRFID(tag)) {
    return;
  }

  if (!validScanType()) {
    showMessage("SCAN TYPE ERR", "IN/OUT/ASSY", 3);
    scheduleReady(2500);
    return;
  }

  const String payload = tag + "/" + deviceId + "/" + scanType;
  debugPrint("Publish : " + payload);

  if (publishPayload(payload)) {
    showMessage("PROCESSING " + scanTypeUpper(), tag, 1);
  }
}

// =====================================================
// BUTTON
// Tekan pendek  : tampilkan debug status.
// Tahan 5 detik : OTA update dari server lokal.
// =====================================================
void handleButton() {
  if (otaRunning) {
    return;
  }

  const bool reading = digitalRead(BUTTON_PIN);

  if (reading != lastButtonReading) {
    lastButtonDebounceTime = millis();
  }

  if (millis() - lastButtonDebounceTime > BUTTON_DEBOUNCE_DELAY) {
    if (reading != buttonState) {
      buttonState = reading;

      if (buttonState == LOW) {
        buttonPressedStart = millis();
        buttonHeldForOta = false;
        buttonMessageActive = true;

        lcdPrint16(0, "HOLD 5 SEC");
        lcdPrint16(1, "FOR OTA UPDATE");
      } else {
        if (!buttonHeldForOta) {
          showDebugStatus();
          buttonMessageStart = millis();
          ESP.restart();
        }

        buttonPressedStart = 0;
        buttonHeldForOta = false;
      }
    }
  }

  if (buttonState == LOW && !buttonHeldForOta) {
    unsigned long holdDuration = millis() - buttonPressedStart;

    if (holdDuration >= OTA_HOLD_TIME) {
      buttonHeldForOta = true;
      buttonMessageActive = false;
      performLocalOTA();
    } else {
      int remain = (OTA_HOLD_TIME - holdDuration + 999) / 1000;
      lcdPrint16(0, "OTA IN " + String(remain) + " SEC");
      lcdPrint16(1, "KEEP HOLDING");
    }
  }

  lastButtonReading = reading;

  if (buttonMessageActive && millis() - buttonMessageStart >= BUTTON_MESSAGE_DURATION) {
    buttonMessageActive = false;
    showReady();
  }
}

// =====================================================
// SETUP
// =====================================================
void setup() {
  Serial.begin(115200);

  loadBootCounter();

  loadDeviceConfig();

  pinMode(BUTTON_PIN, INPUT_PULLUP);

  buzzerBegin();

  RFID.begin(
    RFID_BAUD,
    SERIAL_8N1,
    RFID_RX_PIN,
    RFID_TX_PIN
  );

  lcd.init();
  lcd.backlight();

  // Jika BOOT # naik berarti ESP32 benar-benar restart.
  showBootDiagnostic();

  showMessage("SYSTEM BOOT", "PLEASE WAIT", 1);

  optimizeWireless();

  deviceId = getSafeMacAddress();

  if (isInvalidMac(deviceId)) {
    haltInvalidMac();
  }

  buildTopics();

  debugPrint("Device ID : " + deviceId);
  debugPrint("Scan Type : " + scanType);
  debugPrint("topicTag : " + topicTag);
  debugPrint("topicStatus : " + topicStatus);
  debugPrint("topicReply : " + topicReply);

  client.setServer(mqttServer, mqttPort);
  client.setCallback(callback);

  const bool bufferOk = client.setBufferSize(1536);
  if (!bufferOk) {
    showMessage("MQTT BUFFER", "FAILED", 3);
    delay(2000);
  }

  client.setKeepAlive(30);
  client.setSocketTimeout(5);

  if (!validScanType()) {
    showMessage("SCAN TYPE ERR", "IN/OUT/ASSY", 3);
  }

  lastWifiAttempt = millis() - WIFI_RETRY_INTERVAL;
  lastMqttAttempt = millis() - MQTT_RETRY_INTERVAL;

  maintainWiFi();
}

// =====================================================
// LOOP
// =====================================================
void loop() {
  ensureValidDeviceId();

  maintainWiFi();
  maintainMQTT();

  if (client.connected()) {
    client.loop();
  }

  handleButton();

  if (rfidProcessing && millis() - rfidProcessingStart >= RFID_PROCESSING_TIMEOUT) {
    releaseRFIDProcessing();
    restoreRequested = false;

    debugPrint("RFID processing timeout");
    showMessage("TIMEOUT", "SCAN ULANG", 3);
    scheduleReady(2000);
  }

  if (returnToReady && millis() - returnReadyStart >= returnReadyDelay) {
    returnToReady = false;
    showReady();
  }

  if (client.connected() && millis() - lastHeartbeat >= HEARTBEAT_INTERVAL) {
    ensureValidDeviceId();

    lastHeartbeat = millis();
    client.publish(topicStatus.c_str(), "online", true);
  }

  if (!buttonMessageActive && !rfidProcessing && !otaRunning) {
    const String tag = readTag(RFID);

    if (tag.length() > 0) {
      processTag(tag);
    }
  }

  delay(2);
}