// =====================================================
// MAC VALIDATION
// Tambahan: supaya MAC aneh tidak bisa lolos MQTT/backend.
// Diblokir:
// - kosong
// - 000000000000
// - FFFFFFFFFFFF
// - bukan 12 digit HEX
// =====================================================
String normalizeMac(String mac) {
  mac.trim();
  mac.replace(":", "");
  mac.replace("-", "");
  mac.replace(" ", "");
  mac.toUpperCase();

  return mac;
}

bool isHexChar(char c) {
  return (
    (c >= '0' && c <= '9') ||
    (c >= 'A' && c <= 'F')
  );
}

bool isInvalidMac(String mac) {
  mac = normalizeMac(mac);

  if (mac.length() != 12) {
    return true;
  }

  if (mac == "000000000000") {
    return true;
  }

  if (mac == "FFFFFFFFFFFF") {
    return true;
  }

  for (int i = 0; i < mac.length(); i++) {
    if (!isHexChar(mac.charAt(i))) {
      return true;
    }
  }

  return false;
}

String macFromBytes(const uint8_t mac[6]) {
  char buffer[13];

  snprintf(
    buffer,
    sizeof(buffer),
    "%02X%02X%02X%02X%02X%02X",
    mac[0],
    mac[1],
    mac[2],
    mac[3],
    mac[4],
    mac[5]
  );

  return String(buffer);
}

String getSafeMacAddress() {
  String mac = "";

  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);
  delay(200);

  for (int i = 0; i < 20; i++) {
    uint8_t macBytes[6] = {0, 0, 0, 0, 0, 0};

    esp_err_t err = esp_wifi_get_mac(WIFI_IF_STA, macBytes);

    if (err == ESP_OK) {
      mac = macFromBytes(macBytes);
      mac = normalizeMac(mac);

      if (!isInvalidMac(mac)) {
        return mac;
      }
    }

#if defined(ESP_MAC_WIFI_STA)
    esp_read_mac(macBytes, ESP_MAC_WIFI_STA);

    mac = macFromBytes(macBytes);
    mac = normalizeMac(mac);

    if (!isInvalidMac(mac)) {
      return mac;
    }
#endif

    mac = WiFi.macAddress();
    mac = normalizeMac(mac);

    if (!isInvalidMac(mac)) {
      return mac;
    }

    debugPrint("MAC invalid retry " + String(i + 1) + ": " + mac);
    delay(250);
  }

  return "INVALID_MAC";
}

// =====================================================
// SCAN TYPE DAN CONFIG DEVICE
// =====================================================
bool isValidScanTypeValue(const String &value) {
  return value == "in" || value == "out" || value == "assy";
}

void normalizeScanType(String &value) {
  value.toLowerCase();
  value.trim();
}

bool validScanType() {
  return isValidScanTypeValue(scanType);
}

void loadDeviceConfig() {
  configPrefs.begin("device", false);

  String savedScanType = configPrefs.getString("scanType", "");
  normalizeScanType(savedScanType);

  if (isValidScanTypeValue(savedScanType)) {
    scanType = savedScanType;
    return;
  }

  // Hanya terjadi pada alat yang belum pernah menyimpan scanType.
  scanType = String(DEFAULT_SCAN_TYPE);
  normalizeScanType(scanType);

  if (!isValidScanTypeValue(scanType)) {
    scanType = "out";
  }

  configPrefs.putString("scanType", scanType);
}

void saveScanType(const String &newScanType) {
  String value = newScanType;
  normalizeScanType(value);

  if (!isValidScanTypeValue(value)) {
    return;
  }

  scanType = value;
  configPrefs.putString("scanType", scanType);
}

String scanTypeUpper() {
  String result = scanType;
  result.toUpperCase();
  return result;
}

String otaFirmwareFileName() {
  if (scanType == "in") {
    return "rfid_in.bin";
  }

  if (scanType == "assy") {
    return "rfid_assy.bin";
  }

  return "rfid_out.bin";
}

String otaFirmwareUrl() {
  return String(OTA_BASE_URL) + otaFirmwareFileName();
}

// =====================================================
// MQTT TOPIC
// IN/OUT memakai flow lama.
// ASSY memakai flow RFID PREP ASSY.
// =====================================================
void buildTopics() {
  if (scanType == "assy") {
    topicTag = "rfid/prep/assy/" + deviceId + "/tag";
    topicStatus = "rfid/prep/assy/" + deviceId + "/status";
    topicReply = "rfid/prep/assy/reply/" + deviceId;
  } else {
    topicTag = "rfid/batch/" + deviceId + "/tag";
    topicStatus = "rfid/batch/" + deviceId + "/status";
    topicReply = "rfid/batch/reply/" + deviceId;
  }
}

// =====================================================
// WIRELESS OPTIMIZATION
// =====================================================
void optimizeWireless() {
  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);
  WiFi.setAutoReconnect(true);
  WiFi.persistent(false);
  esp_wifi_set_ps(WIFI_PS_NONE);
  btStop();
}

// =====================================================
// BUZZER, COMPATIBLE ESP32 CORE 2.x DAN 3.x
// =====================================================
void buzzerBegin() {
#if defined(ESP_ARDUINO_VERSION_MAJOR) && ESP_ARDUINO_VERSION_MAJOR >= 3
  ledcAttach(BUZZER_PIN, BUZZER_FREQ, BUZZER_RESOLUTION);
  ledcWriteTone(BUZZER_PIN, 0);
#else
  ledcSetup(BUZZER_CHANNEL, BUZZER_FREQ, BUZZER_RESOLUTION);
  ledcAttachPin(BUZZER_PIN, BUZZER_CHANNEL);
  ledcWriteTone(BUZZER_CHANNEL, 0);
#endif
}

void buzzerTone(int frequency) {
#if defined(ESP_ARDUINO_VERSION_MAJOR) && ESP_ARDUINO_VERSION_MAJOR >= 3
  ledcWriteTone(BUZZER_PIN, frequency);
#else
  ledcWriteTone(BUZZER_CHANNEL, frequency);
#endif
}

void buzzerOff() {
#if defined(ESP_ARDUINO_VERSION_MAJOR) && ESP_ARDUINO_VERSION_MAJOR >= 3
  ledcWriteTone(BUZZER_PIN, 0);
#else
  ledcWriteTone(BUZZER_CHANNEL, 0);
#endif
}

void beep(int duration = 150, int frequency = BUZZER_FREQ) {
  if (duration <= 0) {
    return;
  }

  buzzerTone(frequency);
  delay(duration);
  buzzerOff();
}

void beepCode(int code) {
  if (code <= 0) {
    return;
  }

  if (code == 1) {
    beep(120, 2200);
  } else if (code == 2) {
    beep(120, 2200);
    delay(80);
    beep(120, 2200);
  } else {
    beep(450, 900);
  }
}

// =====================================================
// LCD
// =====================================================
void lcdPrint16(int row, String text) {
  lcd.setCursor(0, row);

  if (text.length() > 16) {
    text = text.substring(0, 16);
  }

  lcd.print(text);

  for (int i = text.length(); i < 16; i++) {
    lcd.print(' ');
  }
}

void showMessage(const String &row1, const String &row2, int beepValue = 0) {
  lcdPrint16(0, row1);
  lcdPrint16(1, row2);
  beepCode(beepValue);
}

// =====================================================
// INVALID MAC STOPPER
// Tambahan: stop total jika deviceId invalid.
// Tidak publish MQTT, tidak baca RFID, tidak lanjut backend.
// =====================================================
void haltInvalidMac() {
  debugPrint("FATAL INVALID MAC: " + deviceId);

  rfidProcessing = false;
  restoreRequested = false;
  returnToReady = false;
  buttonMessageActive = false;
  otaRunning = false;

  if (client.connected()) {
    client.disconnect();
  }

  showMessage("MAC INVALID", "RESTART ESP", 3);

  while (true) {
    delay(1000);
  }
}

bool ensureValidDeviceId() {
  deviceId = normalizeMac(deviceId);

  if (!isInvalidMac(deviceId)) {
    return true;
  }

  haltInvalidMac();
  return false;
}

void scheduleReady(unsigned long delayMs) {
  returnToReady = true;
  returnReadyStart = millis();
  returnReadyDelay = delayMs;
}

String shortOperatorName(String name, int maxLength = 9) {
  name.trim();
  name.toUpperCase();

  if (name.length() == 0) {
    return "NO LOGIN";
  }

  if (name.length() > maxLength) {
    return name.substring(0, maxLength);
  }

  return name;
}

void showReady() {
  if (buttonMessageActive || rfidProcessing || otaRunning) {
    return;
  }

  if (!validScanType()) {
    showMessage("SCAN TYPE ERR", "IN/OUT/ASSY", 0);
    return;
  }

  String row1 = String(actualOutput) + " | " + shortOperatorName(operatorName, 9);
  String row2 = "C" + String(countBundle) + " | L" + String(lineNo) + " | " + scanTypeUpper();

  lcdPrint16(0, row1);
  lcdPrint16(1, row2);
}

// =====================================================
// LCD RESET / RECONNECT DIAGNOSTIC
// =====================================================
String resetReasonText() {
  esp_reset_reason_t reason = esp_reset_reason();

  switch (reason) {
    case ESP_RST_POWERON:
      return "POWER ON";

    case ESP_RST_EXT:
      return "EXT RESET";

    case ESP_RST_SW:
      return "SOFTWARE";

    case ESP_RST_PANIC:
      return "PANIC/CRASH";

    case ESP_RST_INT_WDT:
      return "INT WDT";

    case ESP_RST_TASK_WDT:
      return "TASK WDT";

    case ESP_RST_WDT:
      return "WATCHDOG";

    case ESP_RST_DEEPSLEEP:
      return "DEEPSLEEP";

    case ESP_RST_BROWNOUT:
      return "BROWNOUT";

    case ESP_RST_SDIO:
      return "SDIO";

    default:
      return "UNKNOWN";
  }
}

// Nama tambahan, supaya tetap tersedia kalau ingin dipanggil sebagai esp_rst().
String esp_rst() {
  return resetReasonText();
}

